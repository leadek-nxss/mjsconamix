<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MJSCONAMIX</title>
<script src="/socket.io/socket.io.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui}
body{background:#0a0a0a;color:#fff;min-height:100vh}
header{padding:18px;text-align:center;border-bottom:1px solid #222}
header h1{letter-spacing:3px;color:#ff2a6d}
#mapWrap{position:relative;width:95%;max-width:900px;margin:20px auto;background:#151515;border-radius:20px;overflow:hidden;border:1px solid #222;aspect-ratio:16/9}
#mapImg{width:100%;height:100%;object-fit:cover;opacity:0.6}
.room{position:absolute;transform:translate(-50%,-50%);background:#fff;color:#000;padding:10px 16px;border-radius:25px;font-weight:800;cursor:pointer;box-shadow:0 5px 20px rgba(0,0,0,.6);border:2px solid #fff;transition:.2s}
.room:hover{transform:translate(-50%,-50%) scale(1.1);background:#ff2a6d;color:#fff}
.count{position:absolute;top:-8px;right:-8px;background:#ff2a6d;color:#fff;font-size:11px;padding:3px 7px;border-radius:10px}
#modal{position:fixed;inset:0;background:rgba(0,0,0,.85);display:none;align-items:center;justify-content:center;z-index:100;padding:12px}
#modalBox{background:#1a1a1a;width:100%;max-width:430px;border-radius:18px;border:1px solid #333;display:flex;flex-direction:column;max-height:85vh}
#modalHead{padding:16px;border-bottom:1px solid #222;display:flex;justify-content:space-between}
#msgs{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px}
.msg{background:#222;padding:12px 14px;border-radius:14px;font-size:14px}
.msg small{opacity:.5;font-size:11px;display:block;margin-top:5px}
#sendBar{padding:12px;display:flex;gap:8px;border-top:1px solid #222}
#sendBar input{flex:1;background:#111;border:1px solid #333;border-radius:12px;padding:14px;color:#fff}
#sendBar button{background:#ff2a6d;border:none;color:#fff;padding:14px 20px;border-radius:12px;font-weight:800}
</style>
</head>
<body>
<header><h1>MJSCONAMIX</h1><p style="opacity:.6">Pica un salón y deja tu chisme anónimo 🔥</p></header>
<div id="mapWrap">
  <img id="mapImg" src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=900">
  <div id="roomsLayer" style="position:absolute;inset:0"></div>
</div>
<div id="modal">
  <div id="modalBox">
    <div id="modalHead"><b id="roomTitle">Salón</b><button onclick="closeM()" style="background:none;border:none;color:#fff;font-size:22px">✕</button></div>
    <div id="msgs"></div>
    <div id="sendBar"><input id="txt" placeholder="Mensaje anónimo..." maxlength="200"><button onclick="send()">Enviar</button></div>
  </div>
</div>
<script>
const socket=io();let rooms=[],current=null,allData={};
function renderRooms(){
  const layer=document.getElementById('roomsLayer');layer.innerHTML='';
  rooms.forEach(r=>{
    const d=document.createElement('div');d.className='room';
    d.style.left=r.x+'%';d.style.top=r.y+'%';
    const count=allData.messages&&allData.messages[r.id]?allData.messages[r.id].length:0;
    d.innerHTML=r.name+(count?`<span class="count">${count}</span>`:'');
    d.onclick=()=>openRoom(r);layer.appendChild(d);
  });
}
function openRoom(r){current=r.id;document.getElementById('roomTitle').innerText='Salón '+r.name;document.getElementById('modal').style.display='flex';socket.emit('join-room',r.id);}
function closeM(){document.getElementById('modal').style.display='none';current=null;}
function send(){const t=document.getElementById('txt');if(!t.value.trim())return;socket.emit('send-message',{roomId:current,text:t.value});t.value='';}
document.getElementById('txt').addEventListener('keydown',e=>{if(e.key==='Enter')send();});
function addMsg(m){const box=document.getElementById('msgs');const div=document.createElement('div');div.className='msg';div.innerText=m.text;const sm=document.createElement('small');sm.innerText=new Date(m.time).toLocaleTimeString();div.appendChild(sm);box.appendChild(div);box.scrollTop=box.scrollHeight;}
socket.on('init-data',d=>{allData=d;rooms=d.rooms;if(d.mapImage)document.getElementById('mapImg').src=d.mapImage;renderRooms();});
socket.on('rooms-update',r=>{rooms=r;renderRooms();});
socket.on('map-update',img=>{document.getElementById('mapImg').src=img;});
socket.on('room-messages',list=>{const box=document.getElementById('msgs');box.innerHTML='';if(list.length===0)box.innerHTML='<p style="opacity:.5;text-align:center;margin-top:20px">No hay chismes aún, sé el primero 👀</p>';list.forEach(addMsg);});
socket.on('new-message',m=>{addMsg(m);});
</script>
</body>
</html>
